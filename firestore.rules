rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Allow test connection reads
    match /test/connection {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User history
    match /user_history/{historyId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.toolName is string
        && request.resource.data.toolName.size() <= 100
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 255;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Contact messages (Anyone can submit a contact inquiry)
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 255
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if false;
    }
  }
}
